<!DOCTYPE html>
<html lang="en">
<%- include('partials/header', { title: 'Your cart — Scatch' }) %>
<body>
  <%- include('partials/navbar') %>

  <main class="cart-page">
    <h1>Your cart</h1>
    <p class="page-intro">Your picks, all in one place. You can remove a piece or adjust quantities by adding it again from the shop.</p>

    <% if (items.length === 0) { %>
      <div class="empty-state">
        <h2>Your cart is waiting</h2>
        <p>Explore the rack and add a piece when something catches your eye.</p>
        <a href="/shop" class="btn btn-primary btn-small">Browse the rack</a>
      </div>
    <% } else { %>
      <div class="cart-list">
        <% items.forEach(function(item) { %>
          <div class="cart-row">
            <div class="cart-swatch" style="background-color: <%= item.product.bgcolor %>;"></div>
            <div class="cart-row-info">
              <h3><%= item.product.name %></h3>
              <p class="muted">Qty <%= item.quantity %> · ₹<%= item.product.price - item.product.discount %> each</p>
            </div>
            <span class="mono">₹<%= item.lineTotal %></span>
            <a href="/cart/remove/<%= item.product._id %>" class="cart-remove">Remove</a>
          </div>
        <% }); %>
      </div>

      <div class="cart-summary">
        <span>Total</span>
        <span class="mono cart-total">₹<%= total %></span>
      </div>

      <form action="/cart/checkout" method="POST">
        <button type="submit" class="btn btn-primary btn-full">Checkout</button>
      </form>
      <p class="checkout-note">This demo checkout records your order in your account. No payment will be taken.</p>
    <% } %>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
