<!DOCTYPE html>
<html lang="en">
<%- include('partials/header', { title: 'Your orders — Scatch' }) %>
<body>
  <%- include('partials/navbar') %>

  <main class="orders-page">
    <h1>Order history</h1>
    <p class="page-intro">A record of the pieces you've checked out with, all in one place.</p>

    <% if (orders.length === 0) { %>
      <div class="empty-state">
        <h2>No orders just yet</h2>
        <p>Once you check out, your order details will show up here.</p>
        <a href="/shop" class="btn btn-primary btn-small">Start exploring</a>
      </div>
    <% } else { %>
      <% orders.forEach(function(order, i) { %>
        <div class="order-card">
          <div class="order-head">
            <span>Order #<%= orders.length - i %></span>
            <span class="muted"><%= new Date(order.placedAt).toLocaleDateString() %></span>
          </div>
          <ul class="order-items">
            <% order.items.forEach(function(item) { %>
              <li class="order-item">
                <% if (item.image) { %>
                  <img class="order-thumb" src="<%= item.image %>" alt="<%= item.name %>" loading="lazy" decoding="async">
                <% } else { %>
                  <div class="order-thumb order-thumb-placeholder" role="img" aria-label="No image available for <%= item.name %>"></div>
                <% } %>
                <span><%= item.name %> × <%= item.quantity %></span>
              </li>
            <% }); %>
          </ul>
          <div class="order-total mono">Total: ₹<%= order.total %></div>
        </div>
      <% }); %>
    <% } %>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
