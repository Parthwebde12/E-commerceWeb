<!DOCTYPE html>
<html lang="en">
<%- include('partials/header', { title: 'Wishlist — Scatch' }) %>
<body>
  <%- include('partials/navbar') %>

  <main class="shop-page">
    <div class="shop-heading">
      <div>
        <p class="eyebrow">Your personal shortlist</p>
        <h1>Saved for later</h1>
        <p class="muted">Keep the pieces you love close until you're ready for them.</p>
      </div>
    </div>

    <% if (products.length === 0) { %>
      <div class="empty-state">
        <h2>Your shortlist starts here</h2>
        <p>Save pieces from the shop and they'll be waiting for you here.</p>
        <a href="/shop" class="btn btn-primary btn-small">Explore the rack</a>
      </div>
    <% } else { %>
      <div class="product-grid">
        <% products.forEach(function(product) { %>
          <div class="product-card" style="background-color: <%= product.bgcolor %>; color: <%= product.textcolor %>;">
            <div class="product-image" style="background-color: <%= product.panelcolor %>;">
              <% if (product.image) { %>
                <img src="<%= product.image %>" alt="<%= product.name %>">
              <% } else { %>
                <div class="product-placeholder" aria-label="No product image available">
                  <span>SCATCH</span>
                  <span>COLOUR STUDY</span>
                </div>
              <% } %>
            </div>
            <div class="product-info">
              <h3><%= product.name %></h3>
              <p class="price-tag">₹<%= product.price - product.discount %></p>
            </div>
            <div class="product-actions">
              <a href="/cart/add/<%= product._id %>" class="btn btn-small">Add to cart</a>
              <a href="/wishlist/toggle/<%= product._id %>" class="btn btn-small btn-ghost">Remove</a>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
